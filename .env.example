# AWS Deployment & Region Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# CloudFormation Stack Parameters
STACK_NAME=LoopGuardStack
REMEDIATION_AUTH_TOKEN=change-this-to-a-secure-token-before-deploying
WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-url

# Managed Resource Names
STATE_TABLE_NAME=LoopGuardState
TARGET_FUNCTION_NAME=LoopGuard-TargetFunction
ORCHESTRATOR_FUNCTION_NAME=LoopGuard-OrchestratorFunction
REMEDIATION_FUNCTION_NAME=LoopGuard-RemediationFunction
ALARM_NAME=LoopGuard-TargetInvocationsSpike

# Model Identifiers
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# Target Function Runtime Limits
TARGET_RESERVED_CONCURRENCY=50
MAX_RUNAWAY_ITERATIONS=25
STAGNATION_SIMILARITY_THRESHOLD=0.70
SESSION_QUARANTINE_TTL_SECONDS=600
